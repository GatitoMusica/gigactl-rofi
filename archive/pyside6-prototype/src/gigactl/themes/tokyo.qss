
/* GigaControl - Tokyo Midnight */

QWidget#ControlPopup {
    background-color: #1a1b26;
    color: #c0caf5;
    border: 1px solid #414868;
    border-radius: 14px;
}

QLabel {
    color: #c0caf5;
    background-color: transparent;
}

QLabel#BrandTitle {
    color: #bb9af7;
    font-size: 21px;
    font-weight: 700;
}

QLabel#MutedText {
    color: #7982a9;
    font-size: 10px;
}

QLabel#FooterText {
    color: #565f89;
    font-size: 9px;
    letter-spacing: 1px;
}

QLabel#SectionTitle {
    color: #7aa2f7;
    font-size: 17px;
    font-weight: 700;
}

QLabel#CardTitle {
    color: #7982a9;
    font-size: 9px;
    font-weight: 700;
}

QLabel#MetricValue {
    color: #bb9af7;
    font-size: 24px;
    font-weight: 700;
}

QLabel#InfoBanner {
    background-color: #24283b;
    color: #a9b1d6;
    border: 1px solid #343a55;
    border-radius: 8px;
    padding: 12px;
}

QFrame#MetricCard {
    background-color: #24283b;
    border: 1px solid #343a55;
    border-radius: 10px;
}

QPushButton#NavButton {
    background-color: transparent;
    color: #a9b1d6;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 9px 8px;
    font-size: 10px;
}

QPushButton#NavButton:hover {
    background-color: #24283b;
    color: #c0caf5;
}

QPushButton#NavButton:checked {
    background-color: #292e42;
    color: #7aa2f7;
    border: 1px solid #414868;
}

QMenu {
    background-color: #1a1b26;
    color: #c0caf5;
    border: 1px solid #414868;
    padding: 5px;
}

QMenu::item {
    padding: 8px 25px 8px 12px;
    border-radius: 5px;
}

QMenu::item:selected {
    background-color: #292e42;
    color: #7aa2f7;
}

QMenu::separator {
    height: 1px;
    background-color: #414868;
    margin: 5px 7px;
}
