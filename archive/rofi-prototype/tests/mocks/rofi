#!/usr/bin/env bash

set -u

# Notice dialogs do not consume a menu selection.
for argument in "$@"; do
    if [[ "$argument" == "-e" ]]; then
        exit 0
    fi
done

if [[ -z "${ROFI_MOCK_SEQUENCE_FILE:-}" ]]; then
    printf 'ROFI_MOCK_SEQUENCE_FILE is not set.\n' >&2
    exit 2
fi

if [[ ! -f "$ROFI_MOCK_SEQUENCE_FILE" ]]; then
    printf 'Mock selection sequence file does not exist.\n' >&2
    exit 2
fi

mapfile -t menu_items

if ! IFS= read -r selection < "$ROFI_MOCK_SEQUENCE_FILE"; then
    printf 'No more mock selections available.\n' >&2
    exit 2
fi

temporary_file="${ROFI_MOCK_SEQUENCE_FILE}.tmp.$$"
tail -n +2 "$ROFI_MOCK_SEQUENCE_FILE" > "$temporary_file"
cat "$temporary_file" > "$ROFI_MOCK_SEQUENCE_FILE"
rm -f "$temporary_file"

# Simulate pressing Escape.
if [[ "$selection" == "__CANCEL__" ]]; then
    exit 1
fi

found=0

for item in "${menu_items[@]}"; do
    if [[ "$item" == "$selection" ]]; then
        found=1
        break
    fi
done

if (( found == 0 )); then
    printf 'Mock selection "%s" is not present in this menu.\n' "$selection" >&2
    exit 2
fi

printf '%s\n' "$selection"
